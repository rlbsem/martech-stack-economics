FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
ARG SOURCE_COMMIT
ENV STACK_ECONOMICS_SOURCE_COMMIT=$SOURCE_COMMIT
ENV RUFF_CACHE_DIR=/tmp/ruff PYTHONDONTWRITEBYTECODE=1
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY requirements.lock requirements-browser.lock pyproject.toml LICENSE ./
RUN pip install --no-cache-dir -r requirements.lock
COPY src/ src/
COPY tests/ tests/
COPY scripts/ scripts/
COPY fixtures/ fixtures/
COPY .github/ .github/
COPY Dockerfile.assurance .dockerignore ./
RUN pip install --no-deps --no-build-isolation .
USER 10001:10001
# The acceptance process needs only loopback; the CI invocation disables external networking.
CMD ["python", "scripts/verify_assurance.py", "--output", "/evidence/acceptance"]
